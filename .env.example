# Hostlur Environment Variables
# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Google AI Studio API Configuration for Gemma 4 Multimodal Model
# Note: Keep your API key private. Never commit real keys to Git.
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Database Configuration
DATABASE_URL=sqlite:///./hostlur.db

# Configurable Warden & Hostel Management Contacts
WARDEN_NAME="Dr. R. K. Sharma"
WARDEN_EMAIL="warden.sharma@campus.edu"
WARDEN_PHONE="+91-98765-43210"
CARETAKER_B_PHONE="+91-98765-43211"
CARETAKER_C_PHONE="+91-98765-43212"
EMERGENCY_HELPLINE="+91-112-HOSTEL"
CAMPUS_AMBULANCE="+91-98765-43299"

# Configurable Mess Timings
MESS_BREAKFAST="07:30 AM – 09:30 AM"
MESS_LUNCH="12:30 PM – 02:30 PM"
MESS_SNACKS="05:00 PM – 06:30 PM"
MESS_DINNER="07:45 PM – 09:45 PM"

# Configurable Curfew & Hostel Rules
CURFEW_WEEKDAY="10:00 PM (Sunday – Thursday)"
CURFEW_WEEKEND="11:00 PM (Friday & Saturday)"
